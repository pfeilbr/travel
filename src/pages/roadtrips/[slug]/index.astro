</style>

<script>
  // Plan tabs: one panel at a time, remembered in the URL hash (#plan-b) so a shared link opens it.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-plan-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-plan-panel]')];
  const select = (id: string, push = false) => {
    if (!panels.some((p) => p.dataset.planPanel === id)) return;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.planTab === id)));
    panels.forEach((p) => (p.hidden = p.dataset.planPanel !== id));
    if (push) history.replaceState(null, '', `#plan-${id}`);
    document.dispatchEvent(new CustomEvent('plan-change', { detail: id }));
  };
  tabs.forEach((t) => t.addEventListener('click', () => {
    select(t.dataset.planTab!, true);
    document.getElementById(`plan-${t.dataset.planTab}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  const fromHash = () => {
    const h = location.hash.slice(1);
    const m = h.match(/^plan-(\w+)$/) ?? h.match(/^(\w+)-\d{4}-\d{2}-\d{2}$/);
    if (m) select(m[1]);
    if (h && !h.startsWith('plan-')) document.getElementById(h)?.scrollIntoView();
  };
  fromHash();
  addEventListener('hashchange', fromHash);

  // Things-to-do filter chips.
  const areas = document.querySelector<HTMLElement>('[data-areas]');
  areas?.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach((chip) => chip.addEventListener('click', () => {
    const tag = chip.dataset.tag!;
    areas.querySelectorAll('[data-tag]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    areas.querySelectorAll<HTMLElement>('[data-tags]').forEach((li) => { li.hidden = tag !== 'all' && !li.dataset.tags!.split(' ').includes(tag); });
  }));

  // Share: the native sheet on phones, else copy the link.
  document.querySelector<HTMLButtonElement>('[data-share]')?.addEventListener('click', async () => {
    const label = document.querySelector('[data-share-label]')!;
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else { await navigator.clipboard.writeText(location.href); label.textContent = 'Link copied'; setTimeout(() => (label.textContent = 'Share'), 2000); }
    } catch { /* dismissed */ }
  });
</script>
