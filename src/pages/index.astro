---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PlaceCard from '../components/PlaceCard.astro';
import Icon from '../components/Icon.astro';
import { trips } from '../data/trips';
import { places, placeById } from '../data/places';
import { imagesFor } from '../lib/images';
import { dateRange, hasRoof } from '../lib/format';
import { url } from '../lib/paths';
import { resorts, skiRegions } from '../data/ski';
import { HOLIDAY_KINDS, eventsOf, sortResorts } from '../lib/ski';
import { pursuits, spotsFor } from '../data/outdoors';
import { sortSpots } from '../lib/outdoors';

const trip = [...trips].sort((a, b) => b.checkedAt.localeCompare(a.checkedAt))[0];
const heroImgs = imagesFor('hero');
const hero = heroImgs[0] ?? imagesFor('robert-h-treman')[0];
const picks = trip.topPicks.map((p) => ({ place: placeById[p.placeId], option: trip.options.find((o) => o.placeId === p.placeId)! }));
const regions = [...new Set(places.map((p) => p.region))].sort();
const openCabins = trip.options.reduce((n, o) => n + (typeof o.available.cabin === 'number' ? o.available.cabin : 0), 0);
const roofs = trip.options.filter(hasRoof).length;
const collage = trip.topPicks.map((p) => imagesFor(p.placeId)[0]).filter(Boolean).slice(0, 3);

const skiCollage = sortResorts(resorts, 'recommended').map((r) => imagesFor(r.id)[0]).filter(Boolean).slice(0, 3);
const skiHolidays = eventsOf(resorts, HOLIDAY_KINDS).length;

// Activity tiles: camping, ski and the outdoors sections, each with its best photo and a count.
const activities = [
  { href: 'camping/', label: 'Camping', icon: 'tent', n: places.length + spotsFor('camp').length, noun: 'places to camp', img: imagesFor('robert-h-treman')[0] },
  { href: 'ski/', label: 'Ski', icon: 'snowflake', n: resorts.length, noun: 'resorts', img: skiCollage[0] },
  ...pursuits.filter((p) => p.id !== 'camp').map((p) => {
    const list = spotsFor(p.id);
    return { href: `${p.slug}/`, label: p.short, icon: p.icon, n: list.length, noun: p.noun[1], img: sortSpots(list, 'recommended').map((s) => imagesFor(s.id)[0]).find(Boolean) };
  }),
];

const vibes = [
  { label: 'Cabins with heat', sub: 'Roof, bed, outlet', q: 'lodging=cabin', img: imagesFor('robert-h-treman')[1] ?? imagesFor('robert-h-treman')[0], icon: 'cabin' },
  { label: 'Glamping', sub: 'Safari tents, real beds', q: 'lodging=glamping', img: imagesFor('firelight-camps')[0], icon: 'glamping' },
  { label: 'Waterfalls', sub: 'Gorges and cascades', q: 'do=waterfalls', img: imagesFor('watkins-glen')[0], icon: 'waterfalls' },
  { label: 'Fishing', sub: 'Lakes, rivers, salmon', q: 'do=fishing', img: imagesFor('selkirk-shores')[1] ?? imagesFor('selkirk-shores')[0], icon: 'fishing' },
  { label: 'Near nightlife', sub: 'Camp, then go out', q: 'do=nightlife', img: imagesFor('moreau-lake')[0], icon: 'nightlife' },
  { label: 'Fall foliage', sub: 'Peak color right now', q: 'do=foliage', img: imagesFor('nicks-lake')[0], icon: 'foliage' },
];
---
<Layout title="Waypoint" overlayHeader description="Find your next night outside: cabins, campsites and glamping in Upstate New York, with availability checked live and real ratings." image={hero?.src.src}>
  <section class="hero">
    {hero ? <Image class="hero-img" src={hero.src} alt={hero.alt} widths={[960, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" /> : <div class="hero-img fallback"></div>}
    <div class="shade"></div>
    <div class="container hero-inner">
      <p class="eyebrow"><span class="dot"></span> Live availability · {dateRange(trip.start, trip.end)}</p>
      <h1>Find your next<br />night outside.</h1>
      <p class="lede">Cabins, campsites and glamping across Upstate New York. We check availability live and show real ratings, so you can book in minutes.</p>

      <form class="search" action={url('explore/')} method="get" data-search>
        <label class="seg">
          <span>Where</span>
          <select name="region">
            <option value="">Anywhere upstate</option>
            {regions.map((r) => <option value={r}>{r}</option>)}
          </select>
        </label>
        <label class="seg">
          <span>Stay</span>
          <select name="lodging">
            <option value="">Any lodging</option>
            <option value="cabin">Cabin</option>
            <option value="glamping">Glamping</option>
            <option value="tent">Tent site</option>
          </select>
        </label>
        <label class="seg">
          <span>Drive</span>
          <select name="drive">
            <option value="">Any distance</option>
            <option value="60">Under 1 hr</option>
            <option value="90">Under 90 min</option>
            <option value="120">Under 2 hr</option>
          </select>
        </label>
        <button class="go" aria-label="Search"><Icon name="search" size={18} /><span>Search</span></button>
      </form>
      {hero && <p class="credit">Photo: {hero.alt}, {hero.author} ({hero.license})</p>}
    </div>
  </section>

  <section class="container band">
    <a class="feature" href={url(`trips/${trip.slug}/`)}>
      <div class="collage">
        {collage.map((img) => <Image src={img!.src} alt={img!.alt} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 30vw" />)}
      </div>
      <div class="feature-body">
        <span class="badge badge-pine"><Icon name="check" size={13} />Checked live {new Date(trip.checkedAt + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
        <h2>{trip.title}</h2>
        <p class="muted">{trip.blurb}</p>
        <ul class="stats">
          <li><b>{trip.options.length}</b><span>places</span></li>
          <li><b>{openCabins}</b><span>cabins open</span></li>
          <li><b>{roofs}</b><span>with a roof</span></li>
        </ul>
        <span class="btn btn-primary">See all options <Icon name="chev-right" size={16} /></span>
      </div>
    </a>
  </section>

  <section class="container">
    <div class="sec-head">
      <h2>Top picks for {dateRange(trip.start, trip.end).split(' – ')[0]}</h2>
      <a href={url(`trips/${trip.slug}/`)}>Show all</a>
    </div>
    <div class="rail">
      {picks.map((p, i) => <PlaceCard place={p.place} option={p.option} badge={`Top pick #${i + 1}`} />)}
    </div>
  </section>

  <section class="container">
    <div class="sec-head"><h2>Explore by activity</h2></div>
    <div class="acts">
      {activities.map((a) => (
        <a class="act" href={url(a.href)}>
          {a.img ? <Image src={a.img.src} alt="" widths={[400, 640]} sizes="(max-width: 760px) 50vw, 20vw" /> : <div class="afill"></div>}
          <div class="atext"><span class="ai"><Icon name={a.icon} size={20} /></span><b>{a.label}</b><span>{a.n} {a.noun}</span></div>
        </a>
      ))}
    </div>
  </section>

  {resorts.length > 0 && (
    <section class="container">
      <a class="feature ski" href={url('ski/')}>
        <div class="feature-body">
          <span class="badge snow-badge"><Icon name="snowflake" size={13} />New · Ski season 2026–27</span>
          <h2>Ready for ski season?</h2>
          <p class="muted">{resorts.length} resorts from Vermont and the Adirondacks to Utah, Colorado, Tahoe and Whistler: live snow forecasts, where to stay, après, sleigh rides and the Christmas and New Year’s events.</p>
          <ul class="stats">
            <li><b>{resorts.length}</b><span>resorts</span></li>
            <li><b>{skiRegions.length}</b><span>regions</span></li>
            <li><b>{skiHolidays}</b><span>holiday events</span></li>
          </ul>
          <span class="btn btn-primary">Explore ski resorts <Icon name="chev-right" size={16} /></span>
        </div>
        <div class="collage">
          {skiCollage.length ? skiCollage.map((img) => <Image src={img!.src} alt={img!.alt} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 30vw" />) : <div class="ski-fill"></div>}
        </div>
      </a>
      <div class="region-chips">
        {skiRegions.map((r) => <a class="chip" href={url(`ski/${r.id}/`)}>{r.name}</a>)}
      </div>
    </section>
  )}

  <section class="container">
    <div class="sec-head"><h2>Browse by vibe</h2></div>
    <div class="vibes">
      {vibes.map((v) => (
        <a class="vibe" href={url(`explore/?${v.q}`)}>
          {v.img ? <Image src={v.img.src} alt="" widths={[400, 640]} sizes="(max-width: 760px) 50vw, 16vw" /> : <div class="vfill"></div>}
          <div class="vtext"><Icon name={v.icon} size={20} /><b>{v.label}</b><span>{v.sub}</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="container why">
    <div><span class="wi"><Icon name="calendar" size={24} /></span><h3>Checked live, not guessed</h3><p class="muted">We search the booking systems for your exact dates and show what's actually open, by cabin and by site.</p></div>
    <div><span class="wi"><Icon name="star" size={24} /></span><h3>Real ratings</h3><p class="muted">Google ratings and the themes from recent reviews: what people love, and what to watch out for.</p></div>
    <div><span class="wi"><Icon name="heart" size={24} /></span><h3>Save and share</h3><p class="muted">Heart places into wishlists, write your own reviews, and keep trip plans in one place.</p></div>
  </section>

  <section class="container">
    <div class="cta" data-cta-band>
      <div>
        <h2>Plan your next trip with Waypoint</h2>
        <p>Create a free account to save places, write reviews and keep your trips together.</p>
      </div>
      <button class="btn btn-primary" data-open-signup>Sign up, it's free</button>
    </div>
  </section>
</Layout>

<style>
  .hero { position: relative; min-height: min(92vh, 820px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; }
  .hero :global(.hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: drift 24s ease-out both; }
  .hero .fallback { background: linear-gradient(135deg, #1f6f50, #0f2a20 60%, #e4572e); }
  @keyframes drift { from { transform: scale(1.08); } to { transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) { .hero :global(.hero-img) { animation: none; } }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,.05) 35%, rgba(0,0,0,.25) 60%, rgba(0,0,0,.72) 100%); }
  .hero-inner { position: relative; width: 100%; padding-top: 140px; padding-bottom: 56px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; background: rgba(255,255,255,.16); backdrop-filter: blur(8px); padding: 6px 12px; border-radius: var(--radius-pill); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 0 rgba(74,222,128,.7); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgba(74,222,128,0); } 100% { box-shadow: 0 0 0 0 rgba(74,222,128,0); } }
  .hero h1 { font-family: var(--font-display); font-size: clamp(42px, 7vw, 84px); line-height: 1; letter-spacing: -0.02em; margin: 18px 0 16px; text-shadow: 0 2px 24px rgba(0,0,0,.25); }
  .lede { font-size: clamp(16px, 1.6vw, 19px); max-width: 560px; opacity: .95; }
  .search { display: flex; align-items: center; background: var(--surface-2); color: var(--ink); border-radius: var(--radius-pill); box-shadow: var(--shadow-lg); padding: 8px; max-width: 760px; margin-top: 28px; }
  .seg { flex: 1; display: block; padding: 6px 22px; border-right: 1px solid var(--rule); border-radius: var(--radius-pill); cursor: pointer; min-width: 0; }
  .seg:hover { background: var(--surface); }
  .seg:nth-of-type(3) { border-right: 0; }
  .seg span { display: block; font-size: 12px; font-weight: 700; }
  .seg select { width: 100%; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 14px; padding: 0; appearance: none; cursor: pointer; outline: none; }
  .go { flex: none; height: 52px; min-width: 52px; padding: 0 22px; border: 0; border-radius: var(--radius-pill); background: var(--accent); color: var(--accent-ink); display: inline-flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer; }
  .go:hover { background: var(--accent-hover); }
  .credit { position: absolute; right: var(--gutter); bottom: 44px; font-size: 11px; opacity: .7; margin: 0; max-width: 40ch; text-align: right; }
  @media (max-width: 760px) {
    .search { flex-direction: column; align-items: stretch; border-radius: var(--radius-lg); padding: 10px; }
    .seg { border-right: 0; border-bottom: 1px solid var(--rule); border-radius: 10px; padding: 10px 14px; }
    .seg:nth-of-type(3) { border-bottom: 0; }
    .go { justify-content: center; margin-top: 6px; }
    .credit { display: none; }
  }

  .band { margin-top: -28px; position: relative; z-index: 2; }
  .feature { display: grid; grid-template-columns: 1.2fr 1fr; gap: 0; border-radius: var(--radius-lg); overflow: hidden; background: var(--surface-2); box-shadow: var(--shadow-lg); text-decoration: none; border: 1px solid var(--rule); }
  .collage { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; gap: 4px; min-height: 340px; }
  .collage :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .collage :global(img:first-child) { grid-row: span 2; }
  .feature-body { padding: clamp(24px, 4vw, 44px); display: flex; flex-direction: column; align-items: flex-start; gap: 6px; justify-content: center; }
  .feature-body h2 { font-family: var(--font-display); font-size: clamp(26px, 3vw, 36px); margin: 10px 0 4px; }
  .stats { list-style: none; padding: 0; margin: 10px 0 22px; display: flex; gap: 28px; }
  .stats b { display: block; font-size: 28px; line-height: 1; }
  .stats span { font-size: 13px; color: var(--muted); }
  .feature:hover .btn-primary { background: var(--accent-hover); }
  @media (max-width: 860px) { .feature { grid-template-columns: 1fr; } .collage { min-height: 220px; } }
  .feature.ski { grid-template-columns: 1fr 1.2fr; box-shadow: var(--shadow); }
  .feature.ski .collage { grid-template-columns: 1fr 2fr; }
  .feature.ski .collage :global(img:first-child) { grid-row: span 2; }
  .ski-fill { grid-column: 1 / -1; grid-row: 1 / -1; background: linear-gradient(160deg, #6f9fc9, #2f5f8a 55%, #1d3550); }
  .snow-badge { background: var(--snow-soft); color: var(--snow-ink); box-shadow: none; }
  .region-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
  .acts { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .act { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none; background: var(--surface); }
  .act :global(img), .afill { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .afill { background: linear-gradient(160deg, #6f9fc9, #2f5f8a 55%, #1d3550); }
  .act:hover :global(img) { transform: scale(1.06); }
  .act::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,.78)); }
  .atext { position: absolute; left: 14px; right: 14px; bottom: 14px; z-index: 1; display: grid; gap: 2px; }
  .atext b { font-size: 20px; }
  .atext span { font-size: 13px; opacity: .9; }
  .ai { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,.18); backdrop-filter: blur(6px); margin-bottom: 6px; }
  @media (max-width: 900px) { .acts { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 42%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; } .act { scroll-snap-align: start; } }
  .region-chips .chip { text-decoration: none; }
  @media (max-width: 860px) { .feature.ski { grid-template-columns: 1fr; } .feature.ski .collage { order: -1; } }

  section.container:not(.band):not(.why) { margin-top: 72px; }
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; }
  .sec-head h2 { margin: 0; }
  .sec-head a { font-weight: 600; font-size: 15px; }
  .rail { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 860px) { .rail { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 78%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; } .rail > :global(*) { scroll-snap-align: start; } }

  .vibes { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
  .vibe { position: relative; aspect-ratio: 3 / 4; border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none; background: var(--surface); }
  .vibe :global(img), .vfill { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .vfill { background: linear-gradient(160deg, var(--pine), #0f2a20); }
  .vibe:hover :global(img) { transform: scale(1.06); }
  .vibe::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,.75)); }
  .vtext { position: absolute; left: 14px; right: 14px; bottom: 14px; z-index: 1; display: grid; gap: 2px; }
  .vtext b { font-size: 16px; }
  .vtext span { font-size: 13px; opacity: .85; }
  @media (max-width: 1100px) { .vibes { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .vibes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .why { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 88px; padding-top: 56px; border-top: 1px solid var(--rule); }
  .wi { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--pine-soft); color: var(--pine); margin-bottom: 14px; }
  .why h3 { font-size: 18px; }
  @media (max-width: 760px) { .why { grid-template-columns: 1fr; } }

  .cta { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: clamp(28px, 4vw, 48px); border-radius: var(--radius-lg); background: linear-gradient(120deg, #1f6f50, #12402f); color: #fff; }
  .cta h2 { font-family: var(--font-display); margin-bottom: 6px; }
  .cta p { margin: 0; opacity: .85; }
  .cta .btn { flex: none; }
  @media (max-width: 760px) { .cta { flex-direction: column; align-items: flex-start; } }
</style>

<script>
  import { openAuth } from '../lib/auth-modal';
  import { onUser } from '../lib/supabase';
  import { wireCarousels } from '../lib/carousel';
  import { wireHearts } from '../lib/wishlist';

  wireCarousels();
  wireHearts();
  document.querySelector('[data-open-signup]')?.addEventListener('click', () => openAuth('signup'));
  onUser((u) => { const band = document.querySelector<HTMLElement>('[data-cta-band]'); if (band) band.parentElement!.hidden = !!u; });

  // Drop empty params so URLs stay clean (/explore/?lodging=cabin, not ?region=&lodging=cabin&drive=).
  document.querySelector<HTMLFormElement>('[data-search]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const q = new URLSearchParams();
    new FormData(f).forEach((v, k) => { if (v) q.set(k, String(v)); });
    location.href = f.action + (q.toString() ? `?${q}` : '');
  });
</script>
