---
import { authConfigured } from '../lib/supabase';
---
<dialog class="auth" data-auth-dialog aria-labelledby="auth-title">
  <form method="dialog" class="head">
    <button class="x" aria-label="Close">
      <svg viewBox="0 0 32 32" width="16" height="16" aria-hidden="true"><path d="m6 6 20 20M26 6 6 26" stroke="currentColor" stroke-width="3" fill="none"/></svg>
    </button>
    <h2 id="auth-title" data-title>Log in or sign up</h2>
  </form>

  <div class="body">
    <p class="reason" data-reason hidden></p>
    <h3 class="welcome">Welcome to Waypoint</h3>

    {!authConfigured && (
      <p class="notice">Sign-in isn't switched on for this site yet. Check back soon.</p>
    )}

    <div class="tabs" role="tablist">
      <button role="tab" data-tab="login" aria-selected="true">Log in</button>
      <button role="tab" data-tab="signup" aria-selected="false">Sign up</button>
    </div>

    <form class="email-form" data-email-form novalidate>
      <div class="field-group">
        <label class="field" data-name-field hidden>
          <span>Name</span>
          <input name="name" autocomplete="name" />
        </label>
        <label class="field">
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label class="field" data-password-field>
          <span>Password</span>
          <input name="password" type="password" autocomplete="current-password" minlength="8" />
        </label>
      </div>
      <p class="hint" data-password-hint hidden>At least 8 characters.</p>
      <p class="error" role="alert" data-error hidden></p>
      <p class="success" role="status" data-success hidden></p>
      <button class="btn btn-primary btn-block" data-submit>Continue</button>
      <button type="button" class="link" data-magic>Email me a sign-in link instead</button>
      <button type="button" class="link" data-forgot>Forgot password?</button>
    </form>

    <div class="divider"><span>or</span></div>

    <div class="social">
      <button class="btn btn-outline btn-block" data-oauth="google">
        <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        <span>Continue with Google</span>
      </button>
      <button class="btn btn-outline btn-block" data-oauth="apple">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.8 1.3 10.3.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-4.2ZM13.9 5c.7-.9 1.2-2 1.1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.1.1 2.3-.6 3-1.5Z"/></svg>
        <span>Continue with Apple</span>
      </button>
    </div>
    <p class="fine">By continuing you agree to keep it friendly. We only use your email to sign you in.</p>
  </div>
</dialog>

<style>
  .auth { width: min(568px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); padding: 0; border: 0; border-radius: var(--radius-lg); background: var(--surface-2); color: var(--ink); box-shadow: var(--shadow-lg); }
  .auth::backdrop { background: rgba(0,0,0,.5); }
  .auth[open] { animation: rise .25s cubic-bezier(.2,.8,.2,1); }
  @keyframes rise { from { transform: translateY(24px); opacity: 0; } }
  .head { position: relative; display: flex; align-items: center; justify-content: center; height: 64px; border-bottom: 1px solid var(--rule); margin: 0; }
  .head h2 { font-size: 16px; margin: 0; font-weight: 700; }
  .x { position: absolute; left: 16px; width: 32px; height: 32px; border-radius: 50%; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .x:hover { background: var(--surface); }
  .body { padding: 24px; }
  .welcome { font-size: 22px; margin: 0 0 16px; }
  .reason { background: var(--pine-soft); color: var(--pine); padding: 10px 12px; border-radius: 10px; font-size: 14px; font-weight: 500; }
  .notice { background: var(--surface); padding: 10px 12px; border-radius: 10px; font-size: 14px; color: var(--muted); }
  .tabs { display: flex; gap: 4px; padding: 4px; background: var(--surface); border-radius: 10px; margin-bottom: 16px; }
  .tabs button { flex: 1; height: 36px; border: 0; border-radius: 8px; background: none; cursor: pointer; font-weight: 600; font-size: 14px; color: var(--muted); }
  .tabs button[aria-selected="true"] { background: var(--surface-2); color: var(--ink); box-shadow: var(--shadow-sm); }
  .field-group { border: 1px solid var(--rule-strong); border-radius: 10px; overflow: hidden; margin-bottom: 12px; }
  .field { display: block; padding: 8px 12px; border-top: 1px solid var(--rule-strong); }
  .field-group > .field:first-child, .field-group > [hidden] + .field { border-top: 0; }
  .field:focus-within { box-shadow: inset 0 0 0 2px var(--ink); border-radius: 8px; }
  .field span { display: block; font-size: 12px; color: var(--muted); }
  .field input { width: 100%; border: 0; outline: 0; background: none; color: var(--ink); font: inherit; padding: 2px 0; }
  .hint { font-size: 12px; color: var(--muted); margin: -6px 0 10px; }
  .error { color: var(--danger); font-size: 14px; }
  .success { color: var(--pine); font-size: 14px; font-weight: 500; }
  .link { display: block; margin: 12px auto 0; background: none; border: 0; text-decoration: underline; font-size: 14px; font-weight: 600; cursor: pointer; }
  .divider { display: flex; align-items: center; gap: 14px; color: var(--muted); font-size: 12px; margin: 20px 0; }
  .divider::before, .divider::after { content: ""; flex: 1; border-top: 1px solid var(--rule); }
  .social { display: grid; gap: 12px; }
  .social .btn { justify-content: flex-start; position: relative; }
  .social .btn span { position: absolute; left: 0; right: 0; text-align: center; pointer-events: none; }
  .fine { font-size: 12px; color: var(--muted); margin: 16px 0 0; }
  @media (max-width: 560px) {
    .auth { width: 100vw; max-width: 100vw; max-height: 100dvh; height: 100dvh; margin: 0; border-radius: 0; }
  }
</style>

<script>
  import { supabase, redirectTo, authConfigured, onUser } from '../lib/supabase';
  import type { AuthMode } from '../lib/auth-modal';

  const dlg = document.querySelector<HTMLDialogElement>('[data-auth-dialog]')!;
  const form = dlg.querySelector<HTMLFormElement>('[data-email-form]')!;
  const q = <T extends HTMLElement>(s: string) => dlg.querySelector<T>(s)!;
  const err = q<HTMLElement>('[data-error]');
  const ok = q<HTMLElement>('[data-success]');
  let mode: AuthMode = 'login';

  function show(el: HTMLElement, text: string) { el.textContent = text; el.hidden = !text; }

  function setMode(m: AuthMode) {
    mode = m;
    dlg.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === m)));
    q('[data-name-field]').hidden = m !== 'signup';
    q('[data-password-hint]').hidden = m !== 'signup';
    q('[data-forgot]').hidden = m !== 'login';
    q<HTMLInputElement>('input[name=password]').autocomplete = m === 'signup' ? 'new-password' : 'current-password';
    q('[data-title]').textContent = m === 'signup' ? 'Sign up' : 'Log in';
    q('[data-submit]').textContent = m === 'signup' ? 'Agree and continue' : 'Continue';
    show(err, ''); show(ok, '');
  }

  window.addEventListener('auth:open', (e) => {
    const { mode: m, reason } = (e as CustomEvent).detail ?? {};
    setMode(m ?? 'login');
    show(q('[data-reason]'), reason ?? '');
    dlg.showModal();
    q<HTMLInputElement>('input[name=email]').focus();
  });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((t) => t.addEventListener('click', () => setMode(t.dataset.tab as AuthMode)));

  const disabled = () => { if (!authConfigured) { show(err, "Sign-in isn't switched on yet."); return true; } return false; };
  const values = () => {
    const d = new FormData(form);
    return { email: String(d.get('email') ?? '').trim(), password: String(d.get('password') ?? ''), name: String(d.get('name') ?? '').trim() };
  };
  const validEmail = (s: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s);

  async function busy<T>(fn: () => Promise<T>) {
    const b = q<HTMLButtonElement>('[data-submit]');
    b.disabled = true; b.style.opacity = '.6';
    try { return await fn(); } finally { b.disabled = false; b.style.opacity = ''; }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    show(err, ''); show(ok, '');
    if (disabled()) return;
    const { email, password, name } = values();
    if (!validEmail(email)) return show(err, 'Enter a valid email.');
    if (password.length < 8) return show(err, 'Password must be at least 8 characters.');
    const sb = supabase()!;
    await busy(async () => {
      if (mode === 'signup') {
        const { data, error } = await sb.auth.signUp({ email, password, options: { emailRedirectTo: redirectTo(), data: name ? { full_name: name } : undefined } });
        if (error) return show(err, error.message);
        if (!data.session) return show(ok, `Check ${email} to confirm your account.`);
        dlg.close();
      } else {
        const { error } = await sb.auth.signInWithPassword({ email, password });
        if (error) return show(err, error.message === 'Invalid login credentials' ? 'That email and password don’t match.' : error.message);
        dlg.close();
      }
    });
  });

  q('[data-magic]').addEventListener('click', async () => {
    show(err, ''); show(ok, '');
    if (disabled()) return;
    const { email } = values();
    if (!validEmail(email)) return show(err, 'Enter your email first.');
    const { error } = await supabase()!.auth.signInWithOtp({ email, options: { emailRedirectTo: redirectTo() } });
    error ? show(err, error.message) : show(ok, `We sent a sign-in link to ${email}.`);
  });

  q('[data-forgot]').addEventListener('click', async () => {
    show(err, ''); show(ok, '');
    if (disabled()) return;
    const { email } = values();
    if (!validEmail(email)) return show(err, 'Enter your email first.');
    const { error } = await supabase()!.auth.resetPasswordForEmail(email, { redirectTo: redirectTo() + '?next=account/' });
    error ? show(err, error.message) : show(ok, `If ${email} has an account, a reset link is on its way.`);
  });

  dlg.querySelectorAll<HTMLButtonElement>('[data-oauth]').forEach((b) => b.addEventListener('click', async () => {
    show(err, '');
    if (disabled()) return;
    try { sessionStorage.setItem('auth:return', location.pathname + location.search); } catch {}
    const { error } = await supabase()!.auth.signInWithOAuth({ provider: b.dataset.oauth as 'google' | 'apple', options: { redirectTo: redirectTo() } });
    if (error) show(err, error.message);
  }));

  onUser((u) => { if (u && dlg.open) dlg.close(); });
</script>
