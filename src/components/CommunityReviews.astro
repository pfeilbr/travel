---
import Icon from './Icon.astro';
interface Props { placeId: string; placeName: string; prompt?: string }
const { placeId, placeName, prompt = 'How was the site, the cabin, the trails? Anything future visitors should know?' } = Astro.props;
---
<section class="community" data-community data-place={placeId} data-name={placeName}>
  <div class="head">
    <h2>Waypoint traveler reviews</h2>
    <span class="stat" data-stat></span>
  </div>
  <div class="list" data-list><p class="muted">No traveler reviews yet. Be the first.</p></div>

  <form class="write" data-form hidden>
    <h3 data-form-title>Share your experience</h3>
    <div class="stars" role="radiogroup" aria-label="Your rating">
      {[1, 2, 3, 4, 5].map((n) => (
        <label><input type="radio" name="rating" value={n} required /><span aria-hidden="true"><Icon name="star" size={26} /></span><span class="sr-only">{n} star{n > 1 && 's'}</span></label>
      ))}
    </div>
    <label class="area"><span class="sr-only">Your review</span>
      <textarea name="body" rows="4" maxlength="2000" required placeholder={prompt}></textarea>
    </label>
    <label class="visited">When did you go? <input type="month" name="visited" /></label>
    <p class="error" data-error hidden></p>
    <div class="actions">
      <button class="btn btn-primary" data-submit>Post review</button>
      <button type="button" class="btn btn-ghost" data-delete hidden>Delete my review</button>
    </div>
  </form>
  <button class="btn btn-outline" data-cta>Write a review</button>
</section>

<style>
  .head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .head h2 { margin: 0; }
  .stat { font-weight: 600; display: inline-flex; gap: 4px; align-items: center; }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px 48px; margin: 20px 0 24px; }
  .list :global(.rv-who) { display: flex; gap: 12px; align-items: center; margin-bottom: 8px; }
  .list :global(.rv-av) { width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: var(--bg); display: grid; place-items: center; font-weight: 700; overflow: hidden; }
  .list :global(.rv-av img) { width: 100%; height: 100%; object-fit: cover; }
  .list :global(.rv-meta) { font-size: 13px; color: var(--muted); }
  .list :global(.rv-stars) { color: var(--ink); font-size: 12px; letter-spacing: 1px; }
  .list :global(p) { margin: 4px 0 0; white-space: pre-line; }
  .write { padding: 20px; border: 1px solid var(--rule); border-radius: var(--radius); margin-bottom: 16px; }
  .stars { display: flex; gap: 2px; margin-bottom: 12px; flex-direction: row; }
  .stars input { position: absolute; opacity: 0; }
  .stars label { cursor: pointer; color: var(--rule-strong); }
  .stars label.on { color: var(--gold); }
  .stars input:focus-visible + span { outline: 2px solid var(--accent); border-radius: 4px; }
  textarea { width: 100%; border: 1px solid var(--rule-strong); border-radius: 10px; padding: 12px; font: inherit; background: var(--surface-2); color: var(--ink); resize: vertical; }
  .visited { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--muted); margin: 10px 0; }
  .visited input { font: inherit; padding: 6px 8px; border: 1px solid var(--rule-strong); border-radius: 8px; background: var(--surface-2); color: var(--ink); }
  .actions { display: flex; gap: 8px; }
  .error { color: var(--danger); font-size: 14px; }
</style>

<script>
  import { getUser, onUser, supabase, authConfigured } from '../lib/supabase';
  import { openAuth } from '../lib/auth-modal';

  document.querySelectorAll<HTMLElement>('[data-community]').forEach((root) => {
    const placeId = root.dataset.place!;
    const name = root.dataset.name!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const cta = root.querySelector<HTMLButtonElement>('[data-cta]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const err = root.querySelector<HTMLElement>('[data-error]')!;
    const del = root.querySelector<HTMLButtonElement>('[data-delete]')!;
    const stars = [...form.querySelectorAll<HTMLLabelElement>('.stars label')];
    let mine: { id: string } | null = null;

    const paint = (n: number) => stars.forEach((s, i) => s.classList.toggle('on', i < n));
    form.querySelectorAll<HTMLInputElement>('input[name=rating]').forEach((r) => r.addEventListener('change', () => paint(Number(r.value))));

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    async function load() {
      const sb = supabase();
      if (!sb) return;
      const { data, error } = await sb.from('reviews')
        .select('id, user_id, rating, body, visited_on, created_at, profiles(display_name, avatar_url)')
        .eq('place_id', placeId).order('created_at', { ascending: false }).limit(50);
      if (error || !data) return;
      const uid = getUser()?.id;
      mine = data.find((r) => r.user_id === uid) ?? null;
      if (data.length) {
        const avg = data.reduce((s, r) => s + r.rating, 0) / data.length;
        root.querySelector('[data-stat]')!.innerHTML = `★ ${avg.toFixed(1)} · ${data.length} review${data.length > 1 ? 's' : ''}`;
        list.innerHTML = data.map((r) => {
          const p = (r.profiles as any) ?? {};
          const who = p.display_name || 'Traveler';
          const when = r.visited_on ? new Date(r.visited_on + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : new Date(r.created_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          const av = p.avatar_url ? `<img src="${esc(p.avatar_url)}" alt="" referrerpolicy="no-referrer">` : esc(who.charAt(0).toUpperCase());
          return `<article><div class="rv-who"><span class="rv-av">${av}</span><div><b>${esc(who)}</b><div class="rv-meta">${esc(when)}</div></div></div><div class="rv-stars" aria-label="${r.rating} stars">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</div><p>${esc(r.body)}</p></article>`;
        }).join('');
      }
      if (mine) {
        const r = data.find((x) => x.id === mine!.id)!;
        (form.querySelector(`input[name=rating][value="${r.rating}"]`) as HTMLInputElement).checked = true;
        paint(r.rating);
        (form.elements.namedItem('body') as HTMLTextAreaElement).value = r.body;
        if (r.visited_on) (form.elements.namedItem('visited') as HTMLInputElement).value = r.visited_on.slice(0, 7);
        root.querySelector('[data-form-title]')!.textContent = 'Your review';
        cta.textContent = 'Edit your review';
        del.hidden = false;
      }
    }

    cta.addEventListener('click', () => {
      if (!authConfigured || !getUser()) return openAuth('login', `Log in to review ${name}.`);
      form.hidden = !form.hidden;
      cta.hidden = !form.hidden;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      const d = new FormData(form);
      const rating = Number(d.get('rating'));
      const body = String(d.get('body') ?? '').trim();
      const visited = String(d.get('visited') ?? '');
      if (!rating || !body) { err.textContent = 'Add a star rating and a few words.'; err.hidden = false; return; }
      const row = { place_id: placeId, rating, body, visited_on: visited ? `${visited}-01` : null };
      const sb = supabase()!;
      const { error } = mine
        ? await sb.from('reviews').update(row).eq('id', mine.id)
        : await sb.from('reviews').insert(row);
      if (error) { err.textContent = error.message; err.hidden = false; return; }
      form.hidden = true; cta.hidden = false;
      load();
    });

    del.addEventListener('click', async () => {
      if (!mine || !confirm('Delete your review?')) return;
      await supabase()!.from('reviews').delete().eq('id', mine.id);
      mine = null; form.reset(); paint(0); del.hidden = true;
      cta.textContent = 'Write a review'; form.hidden = true; cta.hidden = false;
      list.innerHTML = '<p class="muted">No traveler reviews yet. Be the first.</p>';
      root.querySelector('[data-stat]')!.textContent = '';
      load();
    });

    onUser(() => load());
  });
</script>
