---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { PlaceImage } from '../lib/images';

interface Props { images: PlaceImage[]; name: string }
const { images, name } = Astro.props;
const top = images.slice(0, 5);
---
{images.length === 0 ? (
  <div class="mosaic empty"><Icon name="pin" size={40} /><span>Photos coming soon</span></div>
) : (
  <div class="mosaic" data-count={top.length} data-mosaic>
    {top.map((img, i) => (
      <button class:list={['tile', { hero: i === 0 }]} data-open={i} aria-label={`Open photo ${i + 1}: ${img.alt}`}>
        <Image src={img.src} alt={img.alt} widths={i === 0 ? [800, 1280] : [400, 640]} sizes={i === 0 ? '(max-width: 760px) 100vw, 50vw' : '25vw'} loading={i === 0 ? 'eager' : 'lazy'} />
      </button>
    ))}
    <button class="btn btn-outline btn-sm all" data-open="0"><Icon name="grid" size={16} />Show all photos</button>
  </div>
)}

<dialog class="lightbox" data-lightbox aria-label={`${name} photos`}>
  <div class="lb-bar">
    <button class="lb-close" data-close aria-label="Close"><Icon name="chev-left" size={18} /></button>
    <span data-pos></span>
    <span></span>
  </div>
  <div class="lb-stage">
    <button class="lb-nav" data-step="-1" aria-label="Previous photo"><Icon name="chev-left" size={18} /></button>
    {images.map((img, i) => (
      <figure class="lb-fig" data-fig={i} hidden={i !== 0}>
        <Image src={img.src} alt={img.alt} widths={[960, 1600]} sizes="90vw" loading="lazy" />
        <figcaption>
          {img.alt}{img.nearby && ' (nearby)'} · Photo: <a href={img.sourceUrl} rel="noopener">{img.author || 'Wikimedia Commons'}</a>,
          {img.licenseUrl ? <a href={img.licenseUrl} rel="noopener license"> {img.license}</a> : ` ${img.license}`}
        </figcaption>
      </figure>
    ))}
    <button class="lb-nav" data-step="1" aria-label="Next photo"><Icon name="chev-right" size={18} /></button>
  </div>
</dialog>

<style>
  .mosaic { position: relative; display: grid; gap: 8px; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 1fr 1fr; height: clamp(300px, 46vw, 480px); border-radius: var(--radius-lg); overflow: hidden; }
  .mosaic[data-count="1"] { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .mosaic[data-count="2"] { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr; }
  .mosaic[data-count="3"] { grid-template-columns: 2fr 1fr; }
  .mosaic[data-count="4"] .tile:nth-child(4) { grid-column: span 2; }
  .tile { padding: 0; border: 0; cursor: zoom-in; overflow: hidden; background: var(--surface); }
  .tile.hero { grid-row: span 2; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: filter .2s, transform .5s; }
  .tile:hover :global(img) { filter: brightness(.88); }
  .all { position: absolute; right: 16px; bottom: 16px; background: var(--surface-2); border-color: var(--ink); }
  .mosaic.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: var(--muted); background: linear-gradient(135deg, var(--pine-soft), var(--surface)); }
  @media (max-width: 760px) {
    .mosaic { margin: 0 calc(-1 * var(--gutter)); border-radius: 0; grid-template-columns: 1fr; grid-template-rows: 1fr; height: 300px; }
    .tile:not(.hero) { display: none; }
    .tile.hero { grid-row: auto; }
  }
  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #0b0b0b; color: #fff; }
  .lightbox::backdrop { background: #000; }
  .lb-bar { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; font-size: 14px; }
  .lb-close { width: 36px; height: 36px; border-radius: 50%; border: 0; background: rgba(255,255,255,.1); color: #fff; display: grid; place-items: center; cursor: pointer; }
  .lb-stage { display: grid; grid-template-columns: 56px 1fr 56px; align-items: center; height: calc(100dvh - 72px); padding-bottom: 16px; }
  .lb-fig { margin: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-width: 0; }
  .lb-fig :global(img) { max-height: calc(100% - 48px); max-width: 100%; width: auto; height: auto; object-fit: contain; border-radius: 6px; }
  .lb-fig figcaption { font-size: 13px; color: #bbb; text-align: center; padding: 0 12px; }
  .lb-fig a { color: #ddd; }
  .lb-nav { width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(255,255,255,.3); background: transparent; color: #fff; display: grid; place-items: center; cursor: pointer; justify-self: center; }
  .lb-nav:hover { background: rgba(255,255,255,.1); }
</style>

<script>
  document.querySelectorAll<HTMLDialogElement>('[data-lightbox]').forEach((lb) => {
    const figs = [...lb.querySelectorAll<HTMLElement>('[data-fig]')];
    let i = 0;
    const show = (n: number) => {
      i = (n + figs.length) % figs.length;
      figs.forEach((f, j) => (f.hidden = j !== i));
      lb.querySelector('[data-pos]')!.textContent = `${i + 1} / ${figs.length}`;
    };
    document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.open)); lb.showModal(); }));
    lb.querySelector('[data-close]')!.addEventListener('click', () => lb.close());
    lb.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(i + Number(b.dataset.step))));
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(i + 1); if (e.key === 'ArrowLeft') show(i - 1); });
    let x0 = 0;
    lb.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1)); });
  });
</script>
