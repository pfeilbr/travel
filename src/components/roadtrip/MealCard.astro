---
import Icon from '../Icon.astro';
import Tags from './Tags.astro';
import type { Meal } from '../../data/roadtrips/types';

interface Props { meal: Meal }
const { meal } = Astro.props;
const KIND: Record<Meal['kind'], string> = { dinner: 'Dinner', lunch: 'Lunch', brunch: 'Breakfast', treat: 'Treat' };
---
<article class="meal">
  <div class="top">
    <span class="kind">{KIND[meal.kind]}</span>
    <span class="muted pp">~${meal.perPerson}/person</span>
  </div>
  <h4><a href={meal.url} rel="noopener">{meal.name}</a></h4>
  <p class="muted cuisine">{meal.cuisine}{meal.rating && <> · <a class="rating" href={meal.rating.url} rel="noopener"><Icon name="star" size={13} />{meal.rating.rating.toFixed(1)}</a></>}</p>
  <p class="why">{meal.why}</p>
  {meal.order && <p class="small"><strong>Order:</strong> {meal.order}</p>}
  {meal.dress && <p class="small"><Icon name="sparkle" size={13} /> {meal.dress}</p>}
  {meal.hours && <p class="small muted"><Icon name="clock" size={13} /> {meal.hours}</p>}
  <div class="foot">
    <Tags tags={meal.tags} />
    {meal.reserveUrl && <a class="btn btn-outline btn-sm" href={meal.reserveUrl} rel="noopener">Reserve<Icon name="ext" size={14} /></a>}
  </div>
</article>

<style>
  .meal { border: 1px solid var(--rule); border-radius: var(--radius); padding: 14px 16px; background: var(--surface-2); display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .top { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; }
  .kind { font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: 12px; color: var(--accent-text); }
  h4 { margin: 0; font-size: 17px; }
  h4 a { color: var(--ink); text-decoration: none; }
  h4 a:hover { text-decoration: underline; }
  .cuisine { margin: 0; font-size: 13px; }
  .cuisine a { color: inherit; text-decoration: none; }
  .why { margin: 0; font-size: 14px; color: var(--ink-2); }
  .small { margin: 0; font-size: 13px; display: flex; gap: 6px; align-items: baseline; }
  .small :global(svg) { flex: none; position: relative; top: 2px; }
  .foot { margin-top: auto; padding-top: 6px; display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
</style>
