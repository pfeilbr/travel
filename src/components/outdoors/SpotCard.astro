---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import type { Spot } from '../../data/outdoors/types';
import { pursuitById } from '../../data/outdoors/pursuits';
import { skiRegionById } from '../../data/ski/regions';
import { imagesFor } from '../../lib/images';
import { priceText, seasonText } from '../../lib/outdoors';
import { url } from '../../lib/paths';

interface Props { spot: Spot; badge?: string; eager?: boolean; showRegion?: boolean; showPursuit?: boolean }
const { spot: s, badge, eager = false, showRegion = true, showPursuit = false } = Astro.props;
const p = pursuitById[s.pursuit];
const imgs = imagesFor(s.id).slice(0, 4);
const href = url(`${p.slug}/${s.id}/`);
const region = skiRegionById[s.region];
const fact = s.facts[0];
---
<article class="card" data-card={s.id}>
  <div class="media">
    <div class="track" data-track>
      {imgs.length ? imgs.map((img, i) => (
        <a href={href} class="slide" tabindex={i ? -1 : 0} aria-label={i ? undefined : s.name}>
          <Image src={img.src} alt={img.alt} widths={[400, 720]} sizes="(max-width: 700px) 92vw, 360px" loading={eager && i === 0 ? 'eager' : 'lazy'} />
        </a>
      )) : (
        <a href={href} class:list={['slide', 'placeholder', s.pursuit]} aria-label={s.name}><Icon name={p.icon} size={40} /><span>{s.name}</span></a>
      )}
    </div>
    {imgs.length > 1 && (
      <>
        <button class="nav prev" data-prev aria-label="Previous photo" tabindex="-1"><Icon name="chev-left" size={14} /></button>
        <button class="nav next" data-next aria-label="Next photo" tabindex="-1"><Icon name="chev-right" size={14} /></button>
        <div class="dots" aria-hidden="true">{imgs.map((_, i) => <span class:list={{ on: i === 0 }} />)}</div>
      </>
    )}
    <div class="tags">
      {badge && <span class="badge">{badge}</span>}
      {showPursuit && <span class="badge"><Icon name={p.icon} size={12} />{p.short}</span>}
    </div>
    <button class="heart" data-save={s.id} data-name={s.name} aria-pressed="false" aria-label={`Save ${s.name}`}>
      <Icon name="heart" size={24} />
    </button>
  </div>
  <a href={href} class="body">
    <div class="row1">
      <h3>{s.name}</h3>
      {s.google && <span class="rating" title={`${s.google.rating} on Google`}><Icon name="star" size={13} />{s.google.rating.toFixed(1)}</span>}
    </div>
    <p class="muted line">{s.kind} · {s.area}{showRegion && <> · {region.short}</>}</p>
    <p class="muted line">{fact ? `${fact.label}: ${fact.value}` : s.tagline} · {seasonText(s.season)}</p>
    {s.price && <p class="price"><strong>{priceText(s.price, region.currency)}</strong></p>}
  </a>
</article>

<style>
  .card { position: relative; min-width: 0; }
  .media { position: relative; aspect-ratio: 20 / 19; border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .track { display: flex; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; height: 100%; scroll-snap-align: start; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .placeholder { display: flex; flex-direction: column; gap: 10px; align-items: center; justify-content: center; text-decoration: none; color: #fff; font-weight: 600; padding: 16px; text-align: center; background: linear-gradient(160deg, #6fa77f, #2f6f4f 55%, #183a2a); }
  .placeholder.paddle { background: linear-gradient(160deg, #6fb3c9, #2f6f8a 55%, #17394d); }
  .placeholder.pickleball { background: linear-gradient(160deg, #c9b56f, #8a7a2f 55%, #4d4217); }
  .placeholder.bike { background: linear-gradient(160deg, #c98f6f, #8a4f2f 55%, #4d2a17); }
  .nav { position: absolute; top: 50%; translate: 0 -50%; width: 32px; height: 32px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: #222; display: grid; place-items: center; cursor: pointer; opacity: 0; transition: opacity .2s, transform .1s; box-shadow: var(--shadow-sm); }
  .nav:hover { transform: scale(1.06); }
  .prev { left: 10px; } .next { right: 10px; }
  .card:hover .nav { opacity: 1; }
  @media (hover: none) { .nav { display: none; } }
  .dots { position: absolute; bottom: 10px; left: 0; right: 0; display: flex; justify-content: center; gap: 5px; pointer-events: none; }
  .dots span { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.6); }
  .dots span.on { background: #fff; transform: scale(1.15); }
  .tags { position: absolute; top: 12px; left: 12px; right: 52px; display: flex; flex-wrap: wrap; gap: 6px; }
  .heart { position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border: 0; background: none; cursor: pointer; display: grid; place-items: center; color: #fff; }
  .heart :global(svg) { fill: rgba(0,0,0,.5); stroke: #fff; stroke-width: 2; transition: fill .15s, transform .15s; }
  .heart:hover :global(svg) { transform: scale(1.08); }
  .heart[aria-pressed="true"] :global(svg) { fill: var(--accent); }
  .heart:global(.pop) :global(svg) { animation: pop .3s; }
  @keyframes pop { 50% { transform: scale(1.3); } }
  .body { display: block; padding-top: 12px; text-decoration: none; font-size: 15px; }
  .row1 { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  h3 { font-size: 15px; font-weight: 600; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rating { flex: none; font-size: 14px; gap: 3px; }
  .line { margin: 2px 0 0; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .price { margin: 6px 0 0; }
</style>
