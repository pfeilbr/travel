---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Place, TripOption } from '../data/types';
import { imagesFor } from '../lib/images';
import { availabilityLine, compact, drive, lowestPrice, money } from '../lib/format';
import { url } from '../lib/paths';

interface Props { place: Place; option?: TripOption; badge?: string; eager?: boolean }
const { place, option, badge, eager = false } = Astro.props;
const imgs = imagesFor(place.id).slice(0, 5);
const price = option ? lowestPrice(option) : null;
const href = url(`places/${place.id}/`);
const label = badge ?? option?.flags[0];
---
<article class="card" data-card={place.id}>
  <div class="media">
    <div class="track" data-track>
      {imgs.length ? imgs.map((img, i) => (
        <a href={href} class="slide" tabindex={i ? -1 : 0} aria-label={i ? undefined : place.name}>
          <Image src={img.src} alt={img.alt} widths={[400, 720]} sizes="(max-width: 700px) 92vw, 360px" loading={eager && i === 0 ? 'eager' : 'lazy'} />
        </a>
      )) : (
        <a href={href} class="slide placeholder" aria-label={place.name}><Icon name="pin" size={36} /></a>
      )}
    </div>
    {imgs.length > 1 && (
      <>
        <button class="nav prev" data-prev aria-label="Previous photo" tabindex="-1"><Icon name="chev-left" size={14} /></button>
        <button class="nav next" data-next aria-label="Next photo" tabindex="-1"><Icon name="chev-right" size={14} /></button>
        <div class="dots" aria-hidden="true">{imgs.map((_, i) => <span class:list={{ on: i === 0 }} />)}</div>
      </>
    )}
    {label && <span class="badge flag">{label}</span>}
    <button class="heart" data-save={place.id} data-name={place.name} aria-pressed="false" aria-label={`Save ${place.name}`}>
      <Icon name="heart" size={24} />
    </button>
  </div>
  <a href={href} class="body">
    <div class="row1">
      <h3>{place.name}</h3>
      <span class="rating" title={`${place.google.rating} on Google from ${place.google.reviews.toLocaleString()} reviews`}>
        <Icon name="star" size={13} />{place.google.rating.toFixed(1)}<span class="muted">({compact(place.google.reviews)})</span>
      </span>
    </div>
    <p class="muted line">{place.town} · {place.region}{option && <> · {drive(option.driveMin)}</>}</p>
    {option && <p class="muted line">{availabilityLine(option)}</p>}
    {price !== null && <p class="price"><span class="muted">From</span> <strong>{money(price)}</strong> <span class="muted">/ night</span></p>}
  </a>
</article>

<style>
  .card { position: relative; min-width: 0; }
  .media { position: relative; aspect-ratio: 20 / 19; border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .track { display: flex; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; height: 100%; scroll-snap-align: start; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .placeholder { display: grid; place-items: center; color: var(--muted); background: linear-gradient(135deg, var(--pine-soft), var(--surface)); }
  .nav { position: absolute; top: 50%; translate: 0 -50%; width: 32px; height: 32px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: #222; display: grid; place-items: center; cursor: pointer; opacity: 0; transition: opacity .2s, transform .1s; box-shadow: var(--shadow-sm); }
  .nav:hover { transform: scale(1.06); }
  .prev { left: 10px; } .next { right: 10px; }
  .card:hover .nav { opacity: 1; }
  @media (hover: none) { .nav { display: none; } }
  .dots { position: absolute; bottom: 10px; left: 0; right: 0; display: flex; justify-content: center; gap: 5px; pointer-events: none; }
  .dots span { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.6); transition: background .2s, transform .2s; }
  .dots span.on { background: #fff; transform: scale(1.15); }
  .flag { position: absolute; top: 12px; left: 12px; }
  .heart { position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border: 0; background: none; cursor: pointer; display: grid; place-items: center; color: #fff; }
  .heart :global(svg) { fill: rgba(0,0,0,.5); stroke: #fff; stroke-width: 2; transition: fill .15s, transform .15s; }
  .heart:hover :global(svg) { transform: scale(1.08); }
  .heart[aria-pressed="true"] :global(svg) { fill: var(--accent); }
  .heart:global(.pop) :global(svg) { animation: pop .3s; }
  @keyframes pop { 50% { transform: scale(1.3); } }
  .body { display: block; padding-top: 12px; text-decoration: none; font-size: 15px; }
  .row1 { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  h3 { font-size: 15px; font-weight: 600; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rating { flex: none; font-size: 14px; gap: 3px; }
  .rating .muted { font-weight: 400; margin-left: 1px; }
  .line { margin: 2px 0 0; font-size: 14px; }
  .price { margin: 6px 0 0; }
</style>
